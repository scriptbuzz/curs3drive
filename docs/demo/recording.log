@@END 0 0.5
@@STEP 10|A file written straight to S3, as a CUR export is, appears on the share.
@@CMD python3 tools/make_sample_workbook.py "$WORK/$EXPORT" --rows 1000 && aws s3 cp "$WORK/$EXPORT" "s3://$BUCKET/demo/$EXPORT" --only-show-errors && echo "Uploaded $EXPORT straight to S3."
@@OUT
Wrote 1,000 rows to cur-export-20261123-110429.xlsx (319,041 bytes).
Uploaded cur-export-20261123-110429.xlsx straight to S3.
@@END 0 0.7
@@CMD aws storagegateway refresh-cache --file-share-arn "$SHARE_ARN" --folder-list /demo --recursive --query NotificationId --output text
@@OUT
95bbf160-2461-4379-8551-c9ada066b1d3
@@END 0 0.6
@@CMD wait_for_share_file "$SHARE/demo/$EXPORT"
@@OUT
The file appeared on the share 0 seconds after the gateway was asked to refresh.
@@END 0 0.2
