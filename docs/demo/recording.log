@@META started=2026-11-23 11:04 EST
@@META gateway=sgw-C712B1AF
@@META address=10.40.0.217
@@META bucket=cur-excel-files-poc-sandbox01
@@META share=/Volumes/cur
@@META region=us-east-1
@@STEP 1|The AWS VPN Client is connected, so the Mac has an address from the VPN range.
@@CMD ifconfig | grep 'inet 10\.50\.'
@@OUT
	inet 10.50.0.34 --> 10.50.0.33 netmask 0xffffffe0
@@END 0 0.0
@@STEP 2|The gateway answers a real SMB handshake through the VPN tunnel. No password is sent.
@@CMD python3 tools/smb_probe.py "$GATEWAY_IP"
@@OUT
The server answered with SMB 3.02 and status 0x00000000.
@@END 0 0.2
@@STEP 3|Finder has mounted the share, and the session is encrypted.
@@CMD mount | grep " on $SHARE "
@@OUT
//smbguest@10.40.0.217/cur on /Volumes/cur (smbfs, nodev, nosuid, mounted by user)
@@END 0 0.0
@@CMD smbutil statshares -m "$SHARE" | grep -E "SMB_VERSION|SMB_CURR_ENCRYPT_ALGORITHM"
@@OUT
                              SMB_VERSION                   SMB_3.1.1
                              SMB_CURR_ENCRYPT_ALGORITHM    AES-128-GCM
@@END 0 0.2
@@STEP 4|The gateway is running, and its cache disk is attached.
@@CMD aws storagegateway describe-gateway-information --gateway-arn "$GATEWAY_ARN" --query "{State:GatewayState,Software:SoftwareVersion,Type:GatewayType}" --output table
@@OUT
------------------------------------
|    DescribeGatewayInformation    |
+----------+-----------+-----------+
| Software |   State   |   Type    |
+----------+-----------+-----------+
|  2.1.16  |  RUNNING  |  FILE_S3  |
+----------+-----------+-----------+
@@END 0 0.7
@@CMD aws storagegateway describe-cache --gateway-arn "$GATEWAY_ARN" --query "{CacheBytes:CacheAllocatedInBytes,UsedPercent:CacheUsedPercentage,WaitingForUploadPercent:CacheDirtyPercentage}" --output table
@@OUT
------------------------------------------------------------
|                       DescribeCache                      |
+--------------+---------------+---------------------------+
|  CacheBytes  |  UsedPercent  |  WaitingForUploadPercent  |
+--------------+---------------+---------------------------+
|  322122547200|  0.06         |  0.0                      |
+--------------+---------------+---------------------------+
@@END 0 0.6
@@STEP 5|Create a workbook with 20,000 made-up CUR rows.
@@CMD python3 tools/make_sample_workbook.py "$WORK/$FILE" --rows 20000 --edition 1
@@OUT
Wrote 20,000 rows to cur-demo-20261123-110429.xlsx (6,547,156 bytes).
@@END 0 0.2
@@STEP 6|Copy the workbook to the share, the same way Excel writes a file it saves.
@@CMD mkdir -p "$SHARE/demo" && time cp "$WORK/$FILE" "$SHARE/demo/$FILE"
@@OUT
The copy took 10.906 seconds.
@@END 0 11.0
@@STEP 7|The gateway uploads the file to S3 in the background.
@@CMD wait_for_new_version "demo/$FILE" "$before"
@@OUT
S3 had a new version of the file 1 second after the save finished.
S3 now holds 2 versions of the file.
@@END 0 0.5
@@CMD aws s3api head-object --bucket "$BUCKET" --key "demo/$FILE" --query "{Bytes:ContentLength,Saved:LastModified,Encryption:ServerSideEncryption}" --output table
@@OUT
--------------------------------------------------------
|                      HeadObject                      |
+---------+--------------+-----------------------------+
|  Bytes  | Encryption   |            Saved            |
+---------+--------------+-----------------------------+
|  6547156|  AES256      |  2026-11-23T16:04:44+00:00  |
+---------+--------------+-----------------------------+
@@END 0 0.5
@@STEP 8|Download the file straight from S3 and compare checksums with the original.
@@CMD aws s3 cp "s3://$BUCKET/demo/$FILE" "$WORK/from-s3.xlsx" --only-show-errors && compare_checksums
@@OUT
Local copy:    828d554151a696953914d4bab7882ecc6ded90c3d21d2f068130e6f0152372a8
Copy from S3:  828d554151a696953914d4bab7882ecc6ded90c3d21d2f068130e6f0152372a8
The checksums match.
@@END 0 1.3
@@STEP 9|Save an edited version through the share. S3 keeps the previous version.
@@CMD python3 tools/make_sample_workbook.py "$WORK/$FILE" --rows 20000 --edition 2 && time cp "$WORK/$FILE" "$SHARE/demo/$FILE"
@@OUT
Wrote 20,000 rows to cur-demo-20261123-110429.xlsx (6,547,726 bytes).
The copy took 10.064 seconds.
@@END 0 10.2
@@CMD wait_for_new_version "demo/$FILE" "$before"
@@OUT
S3 had a new version of the file 1 second after the save finished.
S3 now holds 3 versions of the file.
@@END 0 0.5
@@CMD aws s3api list-object-versions --bucket "$BUCKET" --prefix "demo/$FILE" --query "Versions[].{Latest:IsLatest,Bytes:Size,Saved:LastModified}" --output table
@@OUT
----------------------------------------------------
|                ListObjectVersions                |
+---------+---------+------------------------------+
|  Bytes  | Latest  |            Saved             |
+---------+---------+------------------------------+
|  6547726|  True   |  2026-11-23T16:04:51+00:00   |
|  6547156|  False  |  2026-11-23T16:04:44+00:00   |
|  6547156|  False  |  2026-11-23T16:04:38+00:00   |
